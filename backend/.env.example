GEMINI_API_KEY=replace-me
# Fernet key for encrypting BYOK secrets at rest (any string; empty = BYOK off).
CONFIG_SECRET_KEY=
# UMLS UTS API key — required for SNOMED code retrieval (api retriever).
# Get one free at https://uts.nlm.nih.gov. RxNorm/ICD-10/LOINC need no key.
UMLS_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./anamnesis.db
LOG_LEVEL=INFO
APP_ASSETS_BASE_URL=https://your-domain.ngrok-free.dev
# Dev-only: the scripts under scripts/ talk to a FHIR server directly.
# The server itself takes the base URL and token per request from SHARP headers.
# Capture these from the ngrok inspector at http://127.0.0.1:4040.
DEV_FHIR_BASE_URL=
DEV_FHIR_TOKEN=
